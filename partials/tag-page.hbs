{{!-- Tag page body, shared by tag.hbs and the tag-<layout>.hbs templates (Tag > Other options > Custom template), which wrap it in {{#withListingMode "half"}} etc. --}}
{{> head}}
{{> navbar}}
<main id="main" tabindex="-1" class="content page page--tag">
   {{#tag}}
      <div class="page__header">
         <h1 class="h2 page__title">
            {{ translate 'tag.postFor' }}  #{{name}}
            {{#if tagViewConfig.displayPostCounter}}<sup>({{postsNumber}} {{ translate "tag.post" (math postsNumber '+' 0)}})</sup>{{/if}}
         </h1>
         {{#if tagViewConfig.displayDescription}} 
            {{#if description}}
               <div class="page__desc">{{{description}}}</div>
            {{/if}} 
          {{/if}} 
      </div>
            
      {{#if tagViewConfig.displayPostList}} 
         <div class="posts{{listingModeClass}}{{#unless @config.custom.listingFrame}} posts--plain-thumbs{{/unless}}">
            {{#each ../posts}}
               {{#ifListingMode "full"}}
               <article class="post">
                  <header>
                     <h2 class="h1 post__title"><a href="{{url}}">{{title}}</a></h2>
                     {{#checkIfAny @config.custom.listingDate @config.custom.listingAuthor @config.custom.listingWordCount}}
                        <div class="post__meta">     
                           {{#if @config.custom.listingDate}}
                              <time datetime="{{date createdAt 'YYYY-MM-DDTHH:mm'}}" class="post__date">
                                 {{#checkIf @config.custom.formatDate '!=' 'custom'}}
                                    {{date createdAt @config.custom.formatDate}}
                                 {{else}}
                                    {{date createdAt @config.custom.formatDateCustom}}
                                 {{/checkIf}}
                              </time>
                           {{/if}}
                           {{#if @config.custom.listingWordCount}}{{#with (wordCount text) as |words|}}{{#if words}}<span class="post__words">{{words}} {{translate 'post.words' words}}</span>{{/if}}{{/with}}{{/if}}
                           {{#if @config.custom.listingAuthor}}
                              {{#author}}
                                 <a href="{{url}}" class="post__author">{{name}}</a>
                              {{/author}}
                           {{/if}}
                        </div> 
                     {{/checkIfAny}}   
                     
                     {{#checkIf @config.custom.listingTag '!==' "none" }}
                        <div class="post__tags">
                           {{#checkIf @config.custom.listingTag '==' "maintag" }}
                              {{#if mainTag}}
                                 <a href="{{ mainTag.url }}" class="invert">{{ mainTag.name }}</a>
                              {{/if}}
                           {{else}}
                              {{#each tags}}
                                 <a href="{{url}}" class="invert">{{name}}</a>
                              {{/each}}
                           {{/checkIf}}
                        </div>
                     {{/checkIf}}
                  </header>

                  {{#if @config.custom.listingFeaturedImage}}
                     {{#featuredImage}}
                        {{#if url}}
                           <figure class="post__image post__cover{{#if @config.custom.featuredImagePlain}} post__cover--plain{{else}}{{#unless @config.custom.listingFrame}} post__cover--plain{{/unless}}{{/if}}{{#checkIf width '<' 240}} post__cover--small{{/checkIf}}">
                                 <img
                                    src="{{url}}"
                                    {{#if @config.site.responsiveImages}}
                                       {{responsiveImageAttributes 'featuredImage' srcset sizes}}
                                    {{/if}}
                                    {{ lazyload "lazy" }}
                                    height="{{height}}"
                                    width="{{width}}"
                                    alt="{{alt}}">
                                 {{#checkIfAny caption credits}}
                                    <figcaption>
                                       {{caption}}
                                       {{credits}}
                                    </figcaption>
                                 {{/checkIfAny}}
                              </figure>
                        {{/if}}
                     {{/featuredImage}}      
                  {{/if}}      
                  
                  <div class="post__content">
                     {{#if hasCustomExcerpt}}
                        {{{ excerpt }}}
                     {{else}}
                        <p>{{{ excerpt }}}</p>
                     {{/if}}
                     {{#if @config.custom.listingReadMore}}
                           <a href="{{url}}" class="read-more">{{ translate 'post.readMore' }} &#8594;</a>
                     {{/if}}
                  </div>
               </article>
               {{else}}
               {{> listing-item}}
               {{/ifListingMode}}
            {{/each}}
            {{> pagination}}
         </div>
      {{/if}}
   {{/tag}}
</main>
{{> footer}}
