{{#checkIf @config.custom.listingTag '!==' "none"}}{{#checkIf @config.custom.listingTag '==' "maintag"}}{{#if mainTag}}<span class="post__tags"><a href="{{mainTag.url}}" class="invert">{{mainTag.name}}</a></span>{{/if}}{{else}}{{#if tags}}<span class="post__tags">{{#each tags}}{{#unless @first}} {{/unless}}<a href="{{url}}" class="invert">{{name}}</a>{{/each}}</span>{{/if}}{{/checkIf}}{{/checkIf}}